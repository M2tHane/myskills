{
  "name": "strata-ui-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strata 维护工具：组件总览、原型构建。使用 Strata 做项目时不需要安装它。",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');try{fs.symlinkSync(p.resolve('node_modules'),p.resolve('../node_modules'),'junction')}catch(e){}\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "node ../scripts/check.mjs ../src ../starter/src demo",
    "prototypes": "node scripts/build-prototypes.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-checkbox": "1.1.5",
    "@radix-ui/react-dialog": "1.1.7",
    "@radix-ui/react-dropdown-menu": "2.1.7",
    "@radix-ui/react-popover": "1.1.7",
    "@radix-ui/react-radio-group": "1.2.4",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.1.4",
    "@radix-ui/react-tabs": "1.1.4",
    "@radix-ui/react-tooltip": "1.2.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "lucide-react": "0.488.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.7",
    "react-router": "7.18.4",
    "tailwind-merge": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.4",
    "@types/node": "20.17.30",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3",
    "vite": "6.2.6",
    "vite-plugin-singlefile": "2.2.0"
  }
}
